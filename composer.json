{
    "name": "emerson-pombo/idempotency-linter",
    "description": "Static analyzer that finds Laravel queue jobs without protection against re-execution (idempotency) before they become production incidents.",
    "keywords": [
        "laravel",
        "queue",
        "jobs",
        "idempotency",
        "static-analysis",
        "linter"
    ],
    "license": "MIT",
    "homepage": "https://github.com/Emerson-Pombo/idempotency-linter",
    "type": "library",
    "authors": [
        {
            "name": "Emerson Pombo",
            "email": "emersonpombo5@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Emerson-Pombo/idempotency-linter/issues",
        "source": "https://github.com/Emerson-Pombo/idempotency-linter"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "IdempotencyLinter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdempotencyLinter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IdempotencyLinter\\IdempotencyLinterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
