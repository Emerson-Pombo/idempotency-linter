{
    "name": "emerson-pombo/idempotency-linter",
    "description": "Analisador estático que identifica jobs de fila Laravel sem proteção contra reexecução (idempotência) antes que virem incidentes de produção.",
    "keywords": ["laravel", "queue", "jobs", "idempotency", "static-analysis", "linter"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Emerson Pombo",
            "email": "emersonpombo5@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "IdempotencyLinter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdempotencyLinter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IdempotencyLinter\\IdempotencyLinterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}